{
  "name": "doom-scroll-blocker",
  "version": "1.0.0",
  "description": "A Chrome Extension to block doom-scrolling behavior",
  "main": "background/background.js",
  "scripts": {
    "build": "node -e \"require('fs').copyFileSync('background/background.template.js', 'background/background.js')\"",
    "watch": "chokidar 'utils/constants.js' -c 'npm run build'",
    "lint": "eslint .",
    "test": "jest"
  },
  "keywords": [
    "chrome-extension",
    "productivity",
    "doomscrolling",
    "web-extension"
  ],
  "author": "GSMPRANEETH",
  "license": "MIT",
  "devDependencies": {
    "chokidar": "^3.5.3",
    "eslint": "^8.57.0",
    "jest": "^29.0.0"
  }
}
