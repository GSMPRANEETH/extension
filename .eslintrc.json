{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true,
    "webextensions": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "globals": {
    "chrome": "readonly"
  },
  "extends": "eslint:recommended",
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "no-console": "off",
    "no-empty": [
      "error",
      {
        "allowEmptyCatch": true
      }
    ],
    "eqeqeq": [
      "error",
      "smart"
    ],
    "no-var": "error",
    "prefer-const": "off"
  },
  "overrides": [
    {
      "files": [
        "content/**/*.js"
      ],
      "globals": {
        "DOOM_SCROLL_SITES": "readonly",
        "PRODUCTIVE_SITES": "readonly",
        "CONTEXT_MULTIPLIERS": "readonly",
        "SCORE_THRESHOLDS": "readonly",
        "MOTIVATIONAL_MESSAGES": "readonly",
        "ACTIVITY_REPORT_INTERVAL": "readonly",
        "IDLE_THRESHOLD": "readonly",
        "SCROLL_THROTTLE": "readonly",
        "SNOOZE_DURATION": "readonly",
        "LONG_VIDEO_THRESHOLD": "readonly",
        "SHORT_VIDEO_THRESHOLD": "readonly",
        "BOTTOM_DETECTION_THRESHOLD": "readonly",
        "WHEEL_DELTA_THRESHOLD": "readonly",
        "SWIPE_THRESHOLD": "readonly",
        "POPUP_REFRESH_INTERVAL": "readonly",
        "BREAK_DURATION": "readonly",
        "BREAK_MIN_DURATION": "readonly",
        "CONTINUE_REARM_DELAY": "readonly",
        "SECTION_CHECK_INTERVAL": "readonly",
        "VIDEO_SCROLL_THRESHOLD": "readonly",
        "MIN_CODE_BLOCKS_PRODUCTIVE": "readonly",
        "STRONG_WARNING_FOLLOWUP": "readonly"
      }
    },
    {
      "files": [
        "popup/**/*.js"
      ],
      "globals": {
        "DOOM_SCROLL_SITES": "readonly",
        "PRODUCTIVE_SITES": "readonly",
        "CONTEXT_MULTIPLIERS": "readonly",
        "SCORE_THRESHOLDS": "readonly",
        "MOTIVATIONAL_MESSAGES": "readonly",
        "ACTIVITY_REPORT_INTERVAL": "readonly",
        "IDLE_THRESHOLD": "readonly",
        "SCROLL_THROTTLE": "readonly",
        "SNOOZE_DURATION": "readonly",
        "LONG_VIDEO_THRESHOLD": "readonly",
        "SHORT_VIDEO_THRESHOLD": "readonly",
        "BOTTOM_DETECTION_THRESHOLD": "readonly",
        "WHEEL_DELTA_THRESHOLD": "readonly",
        "SWIPE_THRESHOLD": "readonly",
        "POPUP_REFRESH_INTERVAL": "readonly",
        "BREAK_DURATION": "readonly",
        "BREAK_MIN_DURATION": "readonly",
        "CONTINUE_REARM_DELAY": "readonly",
        "SECTION_CHECK_INTERVAL": "readonly",
        "VIDEO_SCROLL_THRESHOLD": "readonly",
        "MIN_CODE_BLOCKS_PRODUCTIVE": "readonly",
        "STRONG_WARNING_FOLLOWUP": "readonly",
        "getDateKey": "readonly",
        "getWeekKey": "readonly",
        "getMonthKey": "readonly",
        "getPeriodKey": "readonly",
        "getPeriodKeys": "readonly",
        "PERIOD_STAT_KEYS": "readonly",
        "PERIOD_UNIT_LABELS": "readonly",
        "TREND_WINDOW": "readonly",
        "getPeriodWindows": "readonly",
        "sumBucketField": "readonly",
        "calculateFocusSessions": "readonly",
        "calculateTimeSaved": "readonly",
        "calculateImprovementTrend": "readonly"
      }
    },
    {
      "files": [
        "background/background.template.js"
      ],
      "globals": {
        "DOOM_SCROLL_SITES": "readonly",
        "PRODUCTIVE_SITES": "readonly",
        "CONTEXT_MULTIPLIERS": "readonly",
        "SCORE_THRESHOLDS": "readonly",
        "MOTIVATIONAL_MESSAGES": "readonly",
        "ACTIVITY_REPORT_INTERVAL": "readonly",
        "IDLE_THRESHOLD": "readonly",
        "SCROLL_THROTTLE": "readonly",
        "SNOOZE_DURATION": "readonly",
        "LONG_VIDEO_THRESHOLD": "readonly",
        "SHORT_VIDEO_THRESHOLD": "readonly",
        "BOTTOM_DETECTION_THRESHOLD": "readonly",
        "WHEEL_DELTA_THRESHOLD": "readonly",
        "SWIPE_THRESHOLD": "readonly",
        "POPUP_REFRESH_INTERVAL": "readonly",
        "BREAK_DURATION": "readonly",
        "BREAK_MIN_DURATION": "readonly",
        "CONTINUE_REARM_DELAY": "readonly",
        "SECTION_CHECK_INTERVAL": "readonly",
        "VIDEO_SCROLL_THRESHOLD": "readonly",
        "MIN_CODE_BLOCKS_PRODUCTIVE": "readonly",
        "STRONG_WARNING_FOLLOWUP": "readonly",
        "getDateKey": "readonly",
        "getWeekKey": "readonly",
        "getMonthKey": "readonly"
      }
    },
    {
      "files": [
        "scripts/**/*.js"
      ],
      "env": {
        "node": true
      }
    },
    {
      "files": [
        "test/**/*.js"
      ],
      "env": {
        "jest": true,
        "node": true
      }
    },
    {
      "files": [
        "utils/periods.js"
      ],
      "globals": {
        "getDateKey": "readonly",
        "getWeekKey": "readonly",
        "getMonthKey": "readonly"
      }
    },
    {
      "files": [
        "content/content.js"
      ],
      "globals": {
        "showDoomScrollWarning": "readonly",
        "showBreakScreen": "readonly"
      }
    },
    {
      "files": [
        "jest.config.js"
      ],
      "env": {
        "node": true
      }
    },
    {
      "files": [
        "utils/insights.js"
      ],
      "globals": {
        "getPeriodKey": "readonly",
        "getPeriodKeys": "readonly"
      }
    }
  ]
}
